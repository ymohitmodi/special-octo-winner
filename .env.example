# Copy this file to .env and fill in only the platforms you enabled in config.yaml.
# .env is gitignored — never commit real keys.

# --- GitHub (optional but recommended: raises API rate limits) ---
# Fine-grained token with read-only access to the nyx repo is enough.
GITHUB_TOKEN=

# --- Ollama (only needed if base_url is https://ollama.com) ---
OLLAMA_API_KEY=

# --- Bluesky ---
# App password: Settings -> Privacy & Security -> App Passwords
BLUESKY_HANDLE=yourname.bsky.social
BLUESKY_APP_PASSWORD=

# --- Mastodon ---
# Token: Preferences -> Development -> New application (write:statuses scope)
MASTODON_ACCESS_TOKEN=

# --- dev.to ---
# Key: Settings -> Extensions -> DEV Community API Keys
DEVTO_API_KEY=

# --- Discord ---
# Channel settings -> Integrations -> Webhooks -> New Webhook
DISCORD_WEBHOOK_URL=

# --- Telegram ---
# Create a bot with @BotFather; chat id of your channel/group
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- X / Twitter (developer.x.com, app with Read+Write, OAuth 1.0a user context) ---
X_CONSUMER_KEY=
X_CONSUMER_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=
